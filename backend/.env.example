# Application Settings
APP_NAME="Emotional Well-Being Assistant API"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (PostgreSQL Async connection)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_wellbeing_db"

# Synchronous Database URL for Alembic migrations if required
# DATABASE_URL_SYNC="postgresql+psycopg2://postgres:postgres@localhost:5432/ai_wellbeing_db"

# Future Integration Placeholders (Do not commit real keys)
# GEMINI_API_KEY=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_PRIVATE_KEY=""
# FIREBASE_CLIENT_EMAIL=""
